<!--
  RB5 double gear-linkage hand, v2 - uploaded straight-jaw FINGER, re-assembled and modified for
  an accurate pipette return. seeds 0-4 x5: task success 21/25, mean reward 0.83 (v1: 1/25, 0.04).

  Two copies of the gripper assembly, back to back along CAD y (copy 2 turned 180 deg about CAD z,
  shifted -38.33 mm):  g_* copy 1 grips the shaft (actuator "gripper", position, 1.7 N m)
                       s_* copy 2 squeezes the bulb (actuator "squeezer", motor: ctrl = gear torque)
  Hand frame: z = CAD z (approach), x = -CAD y (pipette axis, squeezer side up), y = CAD x (closing).

  1. FINGER placement. FINGER.stl (one part for both sides, part coordinates) sits on its pin holes:
       A (33.48, 37.89) = crank pin C (+-70, 58),  B (-2.73, 7.50) = coupler pin K.
     C-K = 47.27 mm (old finger 47.99), so K lands at (+-40.68, 95.08) in the CAD pose.
  2. FINGER_OFFSET.stl: the straight jaw bar moved 9.4 mm inward (part -y), pins and arm unchanged.
     As uploaded, the jaw edge is ~11 mm further out than the old teeth: the jaws are parallel at
     ~0.23 rad with 36 mm between them, and the wide-open fingers knock the pipette over while the
     robot swings in (Practice 2). Offset, they are parallel where they grip a 6-10 mm shaft.
  3. Grip jaw plates, PTFE face (mu 0.1, priority=1), only as tall as the finger plate (15 mm along
     the pipette, CAD y 3.2..18.2), 40 mm along the jaw - STLs in finger part coordinates:
       JAW_V_L.stl  left : 134 deg V (faces 23 deg), mouth +-17 mm, depth 7.2 mm. Centres the shaft
                    along hand z and holds it there by shape, so it cannot creep.
       JAW_T_R.stl  right: flat tongue 32 mm wide, 1.8 mm thick, passes between the V's horns.
  4. Squeezer pads SQZ_PAD_L/R.stl: 12 mm wide PTFE strip (mu 0.1), so the arc motion of the squeezer
     no longer drags the bulb sideways; narrow so the small bulbs' side walls are not hit.
  5. Floating stage ("carriage"): both copies ride on crossed linear guides (hand y and z, +-16 mm),
     each with a spring-preloaded brake pad (frictionloss 1.5 N). While the jaws close on the
     pipette still in the socket, the stage slides to wherever the pipette is and stays there, so
     the robot puts it back into the (shifted) socket from the nominal pose.
  6. Open-to-centre stops: a pin on each grip crank tip presses into a V-notch on a bracket of the
     flange disk when the gripper opens (stop at 0.05 rad, gripper_open = -0.17 -> full torque).
     The stage is centred and held stiff while the robot moves to the pipette; closing frees it.
  7. CHASSIS_double (one part instead of the two chassis copies), split at the top of its flange disk:
       CHASSIS_DISK  fixed (hand body), bolted to the RB5 flange
       CHASSIS_BODY  plate + 4 legs (5 mm), rides on the floating stage; the crossed guides sit in
                     the leg gap between the disk and the plate.
                     Legs shortened from 13 to 5 mm (hand 8 mm shorter): fewer hits on the pipette
                     during the joint-space swing to the holder (Practice 2).
  Visual meshes don't collide; hidden boxes (group 3) do. Mass 0.63 kg.
-->
<mujoco model="rb5_double_gear_gripper_v2">
  <compiler angle="radian" autolimits="true" meshdir="meshes"/>

  <asset>
    <mesh name="CHASSIS_BODY" file="CHASSIS_BODY.stl"/>
    <mesh name="CHASSIS_DISK" file="CHASSIS_DISK.stl"/>
    <mesh name="GEAR_R" file="GEAR_R.stl"/>
    <mesh name="GEAR_L" file="GEAR_L.stl"/>
    <mesh name="CRANK_R" file="CRANK_R.stl"/>
    <mesh name="CRANK_L" file="CRANK_L.stl"/>
    <mesh name="FINGER_OFFSET" file="FINGER_OFFSET.stl"/>
    <mesh name="COUPLER_R" file="COUPLER_R.stl"/>
    <mesh name="COUPLER_L" file="COUPLER_L.stl"/>
    <mesh name="JAW_V_L" file="JAW_V_L.stl"/>
    <mesh name="JAW_T_R" file="JAW_T_R.stl"/>
    <mesh name="SQZ_PAD_L" file="SQZ_PAD_L.stl"/>
    <mesh name="SQZ_PAD_R" file="SQZ_PAD_R.stl"/>
  </asset>

  <default>
    <!-- STL in mm -> m; mass from the real (watertight) volume -->
    <mesh scale="0.001 0.001 0.001" inertia="exact"/>
    <default class="hand">
      <geom contype="0" conaffinity="0" group="2" rgba="0.62 0.64 0.67 1"/>
      <default class="visual">
        <geom type="mesh" density="1250"/>               <!-- PLA -->
      </default>
      <!-- collision bits: hand geoms = contype 4, conaffinity 1|2 -> hit the pipette, bulb walls,
           holder and bench, never each other. Fingers add bit 8 so left/right fingers collide. -->
      <default class="col">
        <geom contype="4" conaffinity="3" group="3" density="0" condim="3" friction="0.8 0.02 0.001" rgba="0.9 0.4 0.4 0.4"/>
      </default>
      <default class="col_finger_r">
        <geom contype="12" conaffinity="3" group="3" density="0" condim="3" friction="0.8 0.02 0.001" rgba="0.9 0.4 0.4 0.4"/>
      </default>
      <default class="col_finger_l">
        <geom contype="4" conaffinity="11" group="3" density="0" condim="3" friction="0.8 0.02 0.001" rgba="0.9 0.4 0.4 0.4"/>
      </default>
      <!-- jaw inserts: visual mesh with mass (printed, ~60% infill) -->
      <default class="insert">
        <geom type="mesh" density="800"/>
      </default>
      <!-- grip jaw faces (V-block / tongue): hit the shaft, holder and bench, not each other -->
      <default class="jaw">
        <geom type="box" contype="4" conaffinity="1" condim="4" priority="1" friction="0.1 0.02 0.001"
              solref="0.004 1" solimp="0.95 0.99 0.001" rgba="0.2 0.2 0.22 1" density="0" group="3"/>
      </default>
      <!-- squeezer PTFE pad faces: hit the bulb walls; priority=1 so the pad's low friction is used -->
      <default class="notch">
        <geom type="box" contype="0" conaffinity="16" condim="3" friction="0.2 0.005 0.0001" group="3" density="0" rgba="0.2 0.6 0.2 1"/>
      </default>
      <default class="stoppin">
        <geom type="sphere" contype="16" conaffinity="0" condim="3" friction="0.2 0.005 0.0001" group="3" density="0" rgba="0.2 0.6 0.2 1"/>
      </default>
      <default class="sqpad">
        <geom type="box" contype="5" conaffinity="3" condim="4" priority="1" friction="0.1 0.005 0.0001"
              solref="0.004 1" solimp="0.95 0.99 0.001" rgba="0.2 0.2 0.22 1" density="0" group="3"/>
      </default>
      <!-- damping keeps the pads slow (~0.05 m/s): a slam kicks the light pipette away -->
      <default class="gear_g">
        <joint type="hinge" damping="1.6" armature="0.002"/>
      </default>
      <!-- squeezer: light damping so it travels from wide open to the bulb within the 0.6 s -->
      <default class="gear_s">
        <joint type="hinge" damping="0.15" armature="0.002"/>
      </default>
      <default class="pin">
        <joint type="hinge" damping="0.001" armature="1e-5"/>
      </default>
    </default>
  </default>

